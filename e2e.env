# Overrides for the automated browser tests (mock identity provider). Contains no secret: only public test values.
# Use after .env (later files win):
#   docker compose --env-file .env --env-file e2e.env --profile e2e up -d --build
AUTH_ISSUER=http://mock-idp:9099/
SEED_OWNER_SUB=auth0|mock-user-1
SEED_SECOND_SUB=auth0|mock-user-2
# The web container reads the mock IdP values from this file instead of the real Auth0 ones.
WEB_CONFIG=./app-financial-transaction-service/e2e/web-config.json
