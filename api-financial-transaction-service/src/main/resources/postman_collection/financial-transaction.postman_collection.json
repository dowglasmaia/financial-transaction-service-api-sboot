{
	"info": {
		"_postman_id": "0e987e6c-c654-4e02-8374-4e15c5652688",
		"name": "Financial Transaction API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "5139994",
		"description": "Auth0 sign-in (Authorization Code + PKCE, public SPA client, NO client secret).\n1. Fill the collection variables (auth0Domain, clientId are public values).\n2. Add https://oauth.pstmn.io/v1/callback to the Allowed Callback URLs of the Auth0 application.\n3. Collection > Authorization > Get New Access Token, sign in as the test user.\n4. Run the requests. The 'Auth and ownership checks' folder carries tests with the expected status of each case.\nLocal stack: docker compose up (API on baseUrl). Link the demo customer with SEED_OWNER_SUB (and the optional second one with SEED_SECOND_SUB)."
	},
	"item": [
		{
			"name": "Auth and ownership checks",
			"description": "Run signed in as the user linked to the demo customer (account 2022). Each request asserts its expected status.",
			"item": [
				{
					"name": "No token -> 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('401 without a token', () => pm.response.to.have.status(401));",
									"pm.test('standard error body', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/transactions?initial-date=01/01/2000&final-date=31/12/2100",
