								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"transactions"
							],
							"query": [
								{
									"key": "initial-date",
									"value": "01/01/2000"
								},
								{
									"key": "final-date",
									"value": "31/12/2100"
								}
							]
						},
