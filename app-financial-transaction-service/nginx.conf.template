server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Basic hardening headers (a Content-Security-Policy needs the Auth0 and Google Fonts origins listed: a later hardening step)
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # The API, same origin as the app: no CORS in the browser
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Runtime configuration and the entry point must never be cached, or a new deploy would keep the old one
    location = /config.json {
        add_header Cache-Control "no-store" always;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    # Hashed build files are immutable
    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths (deep links such as /transactions/<id>) go to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
