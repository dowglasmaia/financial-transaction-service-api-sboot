# Copy to .env (git-ignored). Example values for a throw-away local database only.
POSTGRES_DB=transactions
POSTGRES_USER=transactions
POSTGRES_PASSWORD=change-me
# Host port of the database container (an API running on the host connects to localhost:POSTGRES_PORT)
POSTGRES_PORT=5433

# Auth0 (all optional: the defaults in application.yaml point to the dev tenant). No secret is ever needed.
# AUTH_ISSUER=https://<tenant>.<region>.auth0.com/
# AUTH_AUDIENCE=https://api.financial-transaction.local
# AUTH_ROLES_CLAIM=https://financial-transaction/roles
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# Link the demo customer (local profile only) to the Auth0 user_id (token sub), e.g. auth0|65f...
# SEED_OWNER_SUB=
# Optional second demo customer (account 3033, balance 1000) linked to a second Auth0 user_id, to try two logins side by side.
# SEED_SECOND_SUB=
